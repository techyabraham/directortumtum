---
import { navItems } from '../data/nav';
import { brand } from '../data/site';
const currentPath = Astro.url.pathname;
---
<button class="menu-trigger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
</button>
<dialog class="mobile-menu" id="mobile-menu" aria-label="Site menu">
  <div class="mobile-menu__top">
    <a href="/" class="mobile-menu__brand">{brand.name}</a>
    <button class="menu-close" type="button" aria-label="Close menu"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </div>
  <nav aria-label="Mobile navigation">
    {navItems.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
    <a class="button" href={brand.whatsappUrl} target="_blank" rel="noreferrer">Enquire on WhatsApp</a>
  </nav>
</dialog>
<script>
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger');
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const closeButton = document.querySelector<HTMLButtonElement>('.menu-close');
  if (trigger && dialog && closeButton) {
    const close = () => { dialog.close(); trigger.setAttribute('aria-expanded', 'false'); trigger.focus(); document.body.classList.remove('menu-open'); };
    trigger.addEventListener('click', () => { dialog.showModal(); trigger.setAttribute('aria-expanded', 'true'); document.body.classList.add('menu-open'); closeButton.focus(); });
    closeButton.addEventListener('click', close);
    dialog.addEventListener('cancel', () => { trigger.setAttribute('aria-expanded', 'false'); document.body.classList.remove('menu-open'); });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
  }
</script>
<style>
  .menu-trigger, .menu-close { display: inline-grid; width: 48px; height: 48px; place-items: center; border: 1px solid var(--border); border-radius: 50%; color: var(--ink); background: transparent; }
  svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .mobile-menu { position: fixed; inset: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: var(--gutter); border: 0; color: white; background: var(--purple-900); }
  .mobile-menu::backdrop { background: var(--purple-900); }
  .mobile-menu__top { display: flex; align-items: center; justify-content: space-between; }
  .mobile-menu__brand { color: white; font-weight: 700; text-decoration: none; }
  .menu-close { border-color: rgb(255 255 255 / 60%); color: white; }
  nav { display: grid; gap: var(--space-4); margin-top: 10vh; }
  nav > a:not(.button) { min-height: 52px; color: white; font: 600 clamp(1.75rem, 8vw, 2.5rem)/1.2 'Space Grotesk', sans-serif; text-decoration: none; }
  nav .button { margin-top: var(--space-4); }
  @media (min-width: 900px) { .menu-trigger, .mobile-menu { display: none; } }
</style>
