---
import ProjectCard from './ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
---
<div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
<style>
  .project-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-7) var(--space-5); }
  @media (min-width: 600px) { .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .project-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
