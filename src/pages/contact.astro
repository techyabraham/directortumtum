---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactLinks from '../components/ContactLinks.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { brand } from '../data/site';
---
<BaseLayout title={`Contact | ${brand.name}`} description={`Contact ${brand.name} about filmmaking, production, post-production or training.`}>
  <main id="main" class="container contact-page">
    <SectionHeading eyebrow="Contact" title="Let’s talk about your story." level={1} />
    <p class="intro">Choose the way you’d like to get in touch.</p>
    <ContactLinks />
    <EnquiryForm />
  </main>
</BaseLayout>
<style>
  .contact-page { min-height: 60vh; padding-block: clamp(3rem, 7vw, 6rem); }
  .intro { max-width: 55ch; margin: calc(-1 * var(--space-5)) 0 var(--space-6); color: var(--ink-muted); }
  .contact-page :global(.enquiry) { margin-top: var(--space-8); }
</style>
