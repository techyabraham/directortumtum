---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import WorkFilters from '../../components/WorkFilters.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { brand } from '../../data/site';
const projects = (await getCollection('projects', ({ data }) => !data.draft || import.meta.env.DEV || import.meta.env.PUBLIC_PREVIEW === 'true'))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={`Work | ${brand.name}`} description={`Documentary and mobile videography films by ${brand.name}.`}>
  <main id="main" class="container work-page">
    <SectionHeading eyebrow="Selected stories" title="Work" level={1} />
    <p class="intro">Real stories and human experiences, captured with intention.</p>
    {projects.length > 0 ? <><WorkFilters /><ProjectGrid projects={projects} /></> : <p>No films are published yet. Please check back soon.</p>}
  </main>
</BaseLayout>
<style>
  .work-page { min-height: 55vh; padding-block: clamp(3rem, 7vw, 6rem); }
  .intro { max-width: 55ch; margin: calc(-1 * var(--space-5)) 0 var(--space-7); color: var(--ink-muted); }
</style>
