---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import Button from '../../components/Button.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import JsonLd from '../../components/JsonLd.astro';
import { brand } from '../../data/site';
export const getStaticPaths = async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft || import.meta.env.DEV || import.meta.env.PUBLIC_PREVIEW === 'true');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } })) as { params: { slug: string }; props: { project: CollectionEntry<'projects'> } }[];
};
const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);
const { data } = project;
const videoUrl = data.video.provider === 'youtube'
  ? `https://www.youtube-nocookie.com/embed/${data.video.id}`
  : data.video.provider === 'vimeo' ? `https://player.vimeo.com/video/${data.video.id}` : undefined;
const videoStructuredData = !data.draft && videoUrl ? {
  '@context': 'https://schema.org', '@type': 'VideoObject', name: data.title, description: data.summary,
  thumbnailUrl: new URL(data.poster.src, brand.siteUrl).href, embedUrl: videoUrl,
} : undefined;
---
<BaseLayout title={`${data.title} | ${brand.name}`} description={data.summary} image={data.poster.src}>
  {videoStructuredData && <JsonLd data={videoStructuredData} />}
  <main id="main" class:list={['container', 'project-page', data.draft && 'draft-only']}>
    <p class="eyebrow"><a href="/work/">Work</a> / {data.categories.map((category) => category.replaceAll('-', ' ')).join(' · ')}</p>
    <h1>{data.title}</h1>
    <p class="summary">{data.summary}</p>
    <VideoEmbed project={project} />
    <div class="project-meta">
      {data.year && <p><strong>Year</strong><span>{data.year}</span></p>}
      {data.location && <p><strong>Location</strong><span>{data.location}</span></p>}
      {data.client && <p><strong>Client</strong><span>{data.client}</span></p>}
      {data.role && <p><strong>Role</strong><span>{data.role.join(', ')}</span></p>}
      {data.credits?.map((credit) => <p><strong>{credit.role}</strong><span>{credit.name}</span></p>)}
    </div>
    <article class="synopsis"><Content /></article>
    <Button href="/work/" variant="secondary">Back to all work</Button>
    {data.draft && <p class="draft-label">DRAFT PLACEHOLDER: replace before launch</p>}
  </main>
</BaseLayout>
<style>
  .project-page { padding-block: var(--space-8) var(--space-12); }
  .eyebrow { color: var(--ink-muted); font-size: .9rem; text-transform: capitalize; }
  h1 { max-width: 18ch; margin: var(--space-5) 0; font-size: clamp(2.25rem, 1.2rem + 5vw, 5rem); }
  .summary { max-width: 65ch; margin-bottom: var(--space-7); color: var(--ink-muted); font-size: 1.2rem; }
  .project-meta { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-8); padding-block: var(--space-5); border-bottom: 1px solid var(--border); }
  .project-meta p { display: grid; gap: .15rem; margin: 0; }
  .project-meta strong { font-size: .8rem; }
  .project-meta span { color: var(--ink-muted); }
  .synopsis { max-width: 65ch; padding-block: var(--space-7); }
  .draft-label { color: var(--ink-muted); }
</style>
