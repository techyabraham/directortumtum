---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { brand } from '../data/site';
---
<BaseLayout title={`Privacy | ${brand.name}`} description={`Plain-language privacy information for the ${brand.name} website.`}>
  <main id="main" class="container privacy-page">
    <SectionHeading eyebrow="Privacy" title="Your privacy matters." level={1} />
    <p>This site does not directly collect or store personal information. The enquiry form prepares a message in WhatsApp or your email application; it does not submit the message to this site.</p>
    <h2>Third-party services</h2>
    <p>If a film is embedded, its video provider may receive technical information and set its own cookies or similar technologies when you play it. This site has no analytics enabled.</p>
    <h2>Contact</h2>
    <p>For privacy questions, contact <a href={brand.whatsappUrl}>{brand.name} on WhatsApp</a>.</p>
    <p>The Nigeria Data Protection Act 2023 is relevant to privacy in Nigeria. This page is informational and does not claim legal compliance; legal review is recommended.</p>
    <p class="review-note">Draft: legal review recommended.</p>
  </main>
</BaseLayout>
<style>
  .privacy-page { max-width: 56rem; min-height: 60vh; padding-block: clamp(3rem, 7vw, 6rem); }
  .privacy-page h2 { margin-top: var(--space-7); font-size: 1.4rem; }
  .review-note { padding: var(--space-3); border-left: 3px solid var(--accent); background: var(--surface); }
</style>
