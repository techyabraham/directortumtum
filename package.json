{
  "name": "director-tumtum-portfolio",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check:install": "node scripts/check-install.mjs",
    "prebuild": "npm run check:install && npm run check:placeholders && npm run check:contrast",
    "build": "astro build",
    "postbuild": "node scripts/add-404-alias.mjs && node scripts/check-output-placeholders.mjs",
    "test": "node tests/unit/helpers.test.mjs",
    "test:e2e": "playwright test",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "preview": "astro preview",
    "check": "astro check && eslint . && npm run check:placeholders && npm run check:contrast",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.0.9",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.5.1",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/space-grotesk": "^5.2.6",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.9",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2"
  }
}
